{
  "config": {
    "step": {
      "device": {
        "title": "Reef Factory device",
        "description": "IP address of the device in your network. Serial number and type are read from the device.",
        "data": {
          "host": "IP address"
        }
      },
      "user": {
        "title": "What do you want to add?",
        "menu_options": {
          "device": "A device by IP address (Level keeper, Thermo control, Reef Flare)",
          "cloud": "Cloud replacement for cloud-only devices (Smart feeder, pumps)"
        }
      },
      "cloud": {
        "title": "Cloud replacement",
        "description": "Home Assistant answers on ports 442 and 444 as if it were api.reeffactory.com. Point that name to this host in your router or DNS filter (see README). Passthrough keeps the official app working while the real cloud exists.",
        "data": {
          "cloud_mode": "Mode"
        }
      }
    },
    "error": {
      "cannot_connect": "No answer. Check the IP address and whether another program is already connected to the device.",
      "unsupported_device": "Device {serial} is not supported (so far: Level keeper, Thermo control, Reef Flare)."
    },
    "abort": {
      "already_configured": "Device is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Pump actions",
        "description": "Manual refill, calibration run and filling the hose run the pump. Used wrongly, the tank can overflow. Stop actions always work.",
        "data": {
          "allow_pump_actions": "Allow pump actions"
        }
      },
      "cloud": {
        "title": "Cloud replacement",
        "data": {
          "cloud_mode": "Mode",
          "upstream_ips": "Addresses of the real cloud (optional, comma separated)"
        },
        "data_description": {
          "upstream_ips": "Leave empty to resolve api.reeffactory.com through a public DNS server."
        }
      }
    }
  },

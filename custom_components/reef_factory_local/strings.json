      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Level keeper."
        },
        "measured_ml": {
          "name": "Measured amount",
          "description": "Amount in the measuring cup in mL."
        },
        "reminder": {
          "name": "Reminder",
          "description": "When to be reminded to calibrate again."
        }
      }
    },
    "calibration_stop": {
      "name": "Stop calibration",
      "description": "Stops a running calibration run.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Level keeper."
        }
      }
    },

  "services": {
    "manual_refill": {
      "name": "Manual refill",
      "description": "Refills the given amount (max 1000 mL). Requires pump actions to be allowed.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Level keeper."
        },
        "amount_ml": {
          "name": "Amount",
          "description": "Amount in mL."
        }
      }
    },
    "manual_refill_stop": {
      "name": "Stop manual refill",
      "description": "Stops a running manual refill.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Level keeper."
        }
      }
    },
    "calibration_start": {
      "name": "Start calibration run",
      "description": "Runs the pump for the given time. Put the hose into a measuring cup first! Requires pump actions to be allowed.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Level keeper."
        },
        "duration_s": {
          "name": "Duration",
          "description": "Run time in seconds."
        }
      }
    },
    "calibration_value": {
      "name": "Finish calibration",

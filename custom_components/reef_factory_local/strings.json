    "flare_manual": {
      "name": "Flare: manual mode",
      "description": "Switch the light to manual mode, optionally with a preset and a duration. After the duration the light returns to its program.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Reef Flare."
        },
        "preset": {
          "name": "Preset",
          "description": "Name of the manual preset to activate (optional)."
        },
        "duration_min": {
          "name": "Duration",
          "description": "Minutes until the light returns to the program; 0 = stay in manual mode."
        }
      }
    },
    "flare_preset_set": {
      "name": "Flare: change manual preset",
      "description": "Change channel levels, intensity or name of a manual preset. The light must be in manual mode.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Reef Flare."
        },
        "preset": {
          "name": "Preset",
          "description": "Name of the preset to change."
        },
        "levels": {
          "name": "Channel levels",
          "description": "7 values 0–100 % in channel order: UV, violet, indigo, blue, green, red, white."
        },
        "intensity": {
          "name": "Intensity",
          "description": "Overall intensity of this preset."
        },
        "new_name": {
          "name": "New name",
          "description": "Up to 16 characters."
        }
      }
    },
    "flare_program_set": {
      "name": "Flare: write program",
      "description": "Replace the points of a stored program. The light must be in program mode; a different program becomes the active one.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Reef Flare."
        },
        "program": {
          "name": "Program",
          "description": "Program name (default: the active program)."
        },
        "points": {
          "name": "Points",
          "description": "List of {time: 'HH:MM', levels: [7 × 0–100]} (channels UV, violet, indigo, blue, green, red, white); first 00:00, last 24:00, at most 31 points."
        },
        "intensity": {
          "name": "Intensity",
          "description": "Overall intensity (default: keep)."
        }
      }
    },
    "flare_program_rename": {
      "name": "Flare: rename program",
      "description": "Rename a stored program.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Reef Flare."
        },
        "program": {
          "name": "Program",
          "description": "Current name."
        },
        "new_name": {
          "name": "New name",
          "description": "Up to 16 characters."
        }
      }
